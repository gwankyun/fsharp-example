<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup><Compile Include="Attribute.fs" /><Compile Include="Args.fs" /><Compile Include="Common.fs" />
    <Compile Include="Record.fs" />
    <Compile Include="Config.fs" />
    <Compile Include="DirStatus.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Include="Expecto" Version="11.1.1" />
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="FSharpPlus" Version="1.9.1" />
    <PackageReference Include="FSLogger" Version="6.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Library\Library.fsproj" />
    <ProjectReference Include="..\Status\Status.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="11.0.101" />
  </ItemGroup>

</Project>
